{
  "name": "react-design-system-validator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "design:lint": "eslint src",
    "design:render": "playwright test -c design-rules",
    "design:check": "npm run design:lint; npm run design:render",
    "design:report": "playwright show-report .design-report/html",
    "design:check:llm": "node design-rules/check.js",
    "design:hook:on": "node design-rules/hook-toggle.js on",
    "design:hook:off": "node design-rules/hook-toggle.js off",
    "design:hook:status": "node design-rules/hook-toggle.js status"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@material/material-color-utilities": "^0.4.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "vite": "^8.3.5"
  },
  "license": "MIT",
  "description": "A React Project that runs an automatic Design System validator (using Material Design 3)"
}
